# container: alpha
:8100 {
	bind unix//run/agentbox/containers/alpha.sock|0660
	log {
		output stderr
		format filter {
			wrap json
			fields {
				request>headers delete
				resp_headers delete
				request>uri regexp \?.* ""
			}
		}
	}
	log_append container alpha
	import agentbox_routes_gw_mine
}

