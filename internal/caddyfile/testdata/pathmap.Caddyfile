# GENERATED by agentbox — do not edit; changes are overwritten on reconcile.
{
	admin unix//run/agentbox/admin.sock|0660
	persist_config off
	auto_https off
	grace_period 10s
	log default {
		format filter {
			wrap json
			fields {
				request>headers delete
				resp_headers delete
				request>uri regexp \?.* ""
			}
		}
	}
}

(agentbox_routes_gw_prod) {
	route {
		@agentbox_dots vars_regexp {http.request.orig_uri.path} (^|/|\\|%5c|%5C|;|%3b|%3B)(\.|%2e|%2E|%252e|%252E){1,2}(/|\\|%5c|%5C|;|%3b|%3B|$)
		respond @agentbox_dots 404
		@agentbox_escapes vars_regexp {http.request.orig_uri.path} ([^\x20-\x7e]|%2[eEfF]|%5[cC]|%25)
		respond @agentbox_escapes 404
		@host_gh_api host api.github.com
		handle @host_gh_api {
			@nocred_gh_api_0 vars {file./run/credentials/caddy.service/gh-pat} ""
			respond @nocred_gh_api_0 "route gh-api unavailable: credential not installed" 503
			request_header -Authorization
			request_header -Proxy-Authorization
			request_header -X-Api-Key
			request_header -Api-Key
			request_header -X-Goog-Api-Key
			request_header -X-Auth-Token
			request_header -Cookie
			request_header -Cf-Aig-*
			request_header -X-Aig-*
			reverse_proxy https://api.github.com {
				flush_interval -1
				header_up Host {upstream_hostport}
				header_up -Forwarded
				header_up -X-Forwarded-*
				header_up Authorization "Bearer {file./run/credentials/caddy.service/gh-pat}"
			}
		}
		@host_gh_codeload host codeload.github.com
		handle @host_gh_codeload {
			request_header -Authorization
			request_header -Proxy-Authorization
			request_header -X-Api-Key
			request_header -Api-Key
			request_header -X-Goog-Api-Key
			request_header -X-Auth-Token
			request_header -Cookie
			request_header -Cf-Aig-*
			request_header -X-Aig-*
			reverse_proxy https://codeload.github.com {
				flush_interval -1
				header_up Host {upstream_hostport}
				header_up -Forwarded
				header_up -X-Forwarded-*
			}
		}
		@host_gh_objects host objects.githubusercontent.com
		handle @host_gh_objects {
			request_header -Authorization
			request_header -Proxy-Authorization
			request_header -X-Api-Key
			request_header -Api-Key
			request_header -X-Goog-Api-Key
			request_header -X-Auth-Token
			request_header -Cookie
			request_header -Cf-Aig-*
			request_header -X-Aig-*
			reverse_proxy https://objects.githubusercontent.com {
				flush_interval -1
				header_up Host {upstream_hostport}
				header_up -Forwarded
				header_up -X-Forwarded-*
			}
		}
		@host_gh_uploads host uploads.github.com
		handle @host_gh_uploads {
			@nocred_gh_uploads_0 vars {file./run/credentials/caddy.service/gh-pat} ""
			respond @nocred_gh_uploads_0 "route gh-uploads unavailable: credential not installed" 503
			request_header -Authorization
			request_header -Proxy-Authorization
			request_header -X-Api-Key
			request_header -Api-Key
			request_header -X-Goog-Api-Key
			request_header -X-Auth-Token
			request_header -Cookie
			request_header -Cf-Aig-*
			request_header -X-Aig-*
			reverse_proxy https://uploads.github.com {
				flush_interval -1
				header_up Host {upstream_hostport}
				header_up -Forwarded
				header_up -X-Forwarded-*
				header_up Authorization "Bearer {file./run/credentials/caddy.service/gh-pat}"
			}
		}
		redir /cloudflare-rest/prod /cloudflare-rest/prod/ 308
		handle_path /cloudflare-rest/prod/* {
			@map_cloudflare_rest_prod_0 path /chat/completions
			rewrite @map_cloudflare_rest_prod_0 /client/v4/accounts/ACCT/ai/v1/chat/completions
			@map_cloudflare_rest_prod_1 path /responses
			rewrite @map_cloudflare_rest_prod_1 /client/v4/accounts/ACCT/ai/v1/responses
			@unmapped_cloudflare_rest_prod not path /chat/completions /responses
			rewrite @unmapped_cloudflare_rest_prod /client/v4/accounts/ACCT/ai{uri}
			@nocred_cloudflare_rest_prod_0 vars {file./run/credentials/caddy.service/cf-aig-token-prod} ""
			respond @nocred_cloudflare_rest_prod_0 "route cloudflare-rest-prod unavailable: credential not installed" 503
			request_header -Authorization
			request_header -Proxy-Authorization
			request_header -X-Api-Key
			request_header -Api-Key
			request_header -X-Goog-Api-Key
			request_header -X-Auth-Token
			request_header -Cookie
			request_header -Cf-Aig-*
			request_header -X-Aig-*
			reverse_proxy https://api.cloudflare.com {
				flush_interval -1
				header_up Host {upstream_hostport}
				header_up -Forwarded
				header_up -X-Forwarded-*
				header_up Authorization "Bearer {file./run/credentials/caddy.service/cf-aig-token-prod}"
				header_up cf-aig-gateway-id "prod"
			}
		}
		redir /cloudflare/prod /cloudflare/prod/ 308
		handle_path /cloudflare/prod/* {
			@map_cloudflare_prod_0 path /v1/messages
			rewrite @map_cloudflare_prod_0 /v1/ACCT/prod/anthropic/v1/messages
			@map_cloudflare_prod_1 path /responses
			rewrite @map_cloudflare_prod_1 /v1/ACCT/prod/openai/responses
			@map_cloudflare_prod_2 path /chat/completions
			rewrite @map_cloudflare_prod_2 /v1/ACCT/prod/compat/chat/completions
			@unmapped_cloudflare_prod not path /v1/messages /responses /chat/completions
			rewrite @unmapped_cloudflare_prod /v1/ACCT/prod{uri}
			@nocred_cloudflare_prod_0 vars {file./run/credentials/caddy.service/cf-aig-token-prod} ""
			respond @nocred_cloudflare_prod_0 "route cloudflare-prod unavailable: credential not installed" 503
			request_header -Authorization
			request_header -Proxy-Authorization
			request_header -X-Api-Key
			request_header -Api-Key
			request_header -X-Goog-Api-Key
			request_header -X-Auth-Token
			request_header -Cookie
			request_header -Cf-Aig-*
			request_header -X-Aig-*
			reverse_proxy https://gateway.ai.cloudflare.com {
				flush_interval -1
				header_up Host {upstream_hostport}
				header_up -Forwarded
				header_up -X-Forwarded-*
				header_up cf-aig-authorization "Bearer {file./run/credentials/caddy.service/cf-aig-token-prod}"
			}
		}
		redir /github-api /github-api/ 308
		handle_path /github-api/* {
			@nocred_github_api_0 vars {file./run/credentials/caddy.service/gh-pat} ""
			respond @nocred_github_api_0 "route github-api unavailable: credential not installed" 503
			request_header -Authorization
			request_header -Proxy-Authorization
			request_header -X-Api-Key
			request_header -Api-Key
			request_header -X-Goog-Api-Key
			request_header -X-Auth-Token
			request_header -Cookie
			request_header -Cf-Aig-*
			request_header -X-Aig-*
			reverse_proxy https://api.github.com {
				flush_interval -1
				header_up Host {upstream_hostport}
				header_up -Forwarded
				header_up -X-Forwarded-*
				header_up Authorization "Bearer {file./run/credentials/caddy.service/gh-pat}"
			}
		}
		redir /github-git /github-git/ 308
		handle_path /github-git/* {
			@nocred_github_git_0 vars {file./run/credentials/caddy.service/gh-pat.basic} ""
			respond @nocred_github_git_0 "route github-git unavailable: credential not installed" 503
			request_header -Authorization
			request_header -Proxy-Authorization
			request_header -X-Api-Key
			request_header -Api-Key
			request_header -X-Goog-Api-Key
			request_header -X-Auth-Token
			request_header -Cookie
			request_header -Cf-Aig-*
			request_header -X-Aig-*
			reverse_proxy https://github.com {
				flush_interval -1
				header_up Host {upstream_hostport}
				header_up -Forwarded
				header_up -X-Forwarded-*
				header_up Authorization "Basic {file./run/credentials/caddy.service/gh-pat.basic}"
			}
		}
		handle {
			respond "unknown route" 404
		}
	}
}

# container: dev
:8100 {
	bind unix//run/agentbox/containers/dev.sock|0660
	log {
		output stderr
		format filter {
			wrap json
			fields {
				request>headers delete
				resp_headers delete
				request>uri regexp \?.* ""
			}
		}
	}
	log_append container dev
	import agentbox_routes_gw_prod
}
